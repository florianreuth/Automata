import Footer from "../components/Footer.astro";
import Base from "../layouts/Base.astro";
import { modules } from "../lib/modules.ts";
import { withBase } from "../lib/paths.ts";

const available = modules.filter((module) => module.href);
---

<Base title="Automata – Formale Sprachen interaktiv" description="Endliche Automaten, reguläre Ausdrücke und Grammatiken im Browser ausprobieren.">
    <main class="home">
        <header class="hero">
            <h1>Automata</h1>
            <p class="lead">Endliche Automaten, reguläre Ausdrücke und Grammatiken im Browser ausprobieren. Angelehnt an JFLAP, ohne Installation.</p>
        </header>

        <section aria-labelledby="modules-heading">
            <h2 id="modules-heading">Bereiche</h2>
            <ul class="modules">
                {available.map((module) => (
                    <li class="module">
                        <h3><a href={withBase(module.href!)}>{module.title}</a></h3>
                        <p>{module.description}</p>
                    </li>
                ))}
            </ul>
        </section>

        <Footer/>
    </main>
</Base>

<style>
    .home {
        width: 100%;
        max-width: 64rem;
        margin: 0 auto;
        padding: 72px 16px 40px;
    }

    h1 {
        font-size: clamp(2.75rem, 10vw, 4.5rem);
        font-weight: 680;
        line-height: 1.05;
        letter-spacing: -0.04em;
    }

    .lead {
        max-width: 40rem;
        margin-top: 16px;
        color: var(--muted);
        font-size: 1.1875rem;
        text-wrap: pretty;
    }

    h2 {
        margin-top: 72px;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .modules {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
        gap: 14px;
        margin-top: 16px;
        list-style: none;
    }

    .module {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
        border: 1px solid var(--rule);
        border-radius: 14px;
        background: var(--surface);
        transition: border-color 0.2s, transform 0.2s var(--ease);
    }

    .module:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
    }

    h3 {
        font-size: 1.0625rem;
        font-weight: 600;
    }

    h3 a {
        color: inherit;
        text-decoration: none;
    }

    h3 a::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .module p {
        color: var(--muted);
        font-size: 0.9375rem;
        text-wrap: pretty;
    }
</style>
